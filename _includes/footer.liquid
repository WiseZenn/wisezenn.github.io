{% capture footer_contents %}
  {% assign t = site.data.i18n[site.active_lang] | default: site.data.i18n.en %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. 
  {% if site.active_lang == "zh" %}
    通过 <a href="https://jekyllrb.com/" target="_blank">Jekyll</a> 强力驱动，主题基于 <a href="https://github.com/alshedivat/al-folio">al-folio</a>。
    托管在 <a href="https://pages.github.com/" target="_blank">GitHub Pages</a>。
    照片来自 <a href="https://unsplash.com" target="_blank">Unsplash</a>。
  {% else %}
    {{ site.footer_text }}
  {% endif %}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    {% assign footer_date_format = t.footer.date_format | default: '%B %d, %Y' %}
    {{ t.footer.last_updated_prefix | default: 'Last updated:' }} {{ 'now' | date: footer_date_format }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

{% if site.data.socials.wechat_qr %}
  <div id="WeChatMod" class="wechat-modal">
    <img src="{{ site.data.socials.wechat_qr.qr_img | prepend: 'assets/img/' | relative_url }}" alt="WeChat QR Code">
  </div>
{% endif %}
